{{- $posts := (where site.RegularPages "Section" "post").ByDate.Reverse -}}
<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom"><channel>
<title>{{ site.Params.brand }}</title><link>{{ site.Home.Permalink }}</link><description>{{ site.Params.description }}</description><language>zh-CN</language>
<atom:link href="{{ .Permalink }}" rel="self" type="application/rss+xml"/>
{{ range $posts }}<item><title>{{ .Title }}</title><link>{{ .Permalink }}</link><guid>{{ .Permalink }}</guid>
{{ if not .Date.IsZero }}<pubDate>{{ .Date.Format "Mon, 02 Jan 2006 15:04:05 -0700" }}</pubDate>{{ end }}<description>{{ partial "excerpt.html" . }}</description></item>{{ end }}
</channel></rss>
